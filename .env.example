# Copy to .env and fill in. Never commit .env.
#   copy .env.example .env

# --- Kaggle (kernel push / dataset upload) ---
# Prefer `kaggle auth login` (OAuth). These are optional overrides:
KAGGLE_USERNAME=
KAGGLE_KEY=
# Or newer CLI token:
KAGGLE_API_TOKEN=

# --- GitHub (only if kronos-research is private; attach same value as Kaggle secret GITHUB_TOKEN) ---
GITHUB_TOKEN=

# --- Hugging Face (optional; public Kronos/FinBERT usually work without it) ---
HF_TOKEN=

# --- BTC news ---
CRYPTOCOMPARE_API_KEY=

# --- General / short-history news (NewsAPI free = ~1 month history) ---
NEWSAPI_KEY=

# --- XAU / forex news (trial or paid) ---
FOREX_NEWS_API_TOKEN=

# --- Parse.bot (ForexFactory calendar / news endpoints) ---
PARSEBOT=

# --- Optional later ---
POLYGON_API_KEY=
FXMACRODATA_API_KEY=
